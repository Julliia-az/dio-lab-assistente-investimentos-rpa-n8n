      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        800,
        128
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "clientes",
        "options": {}
      },
      "id": "79511b1a-1335-4652-ade3-2bff8de2c4d0",
      "name": "Separar Clientes",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1.1,
      "position": [
        1024,
        128
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "saldo_num",
              "name": "saldo_num",
              "type": "number",
              "value": "={{ Number(String($json.saldo).replace(/[^0-9,]/g, '').replace(',', '.')) }}"
            },
            {
              "id": "opcoes",
              "name": "opcoes",
              "type": "array",
              "value": "={{ $('Agrupar Investimentos').first().json.investimentos.filter(i => i.perfil === $json.perfil && Number(i.minimo) <= Number(String($json.saldo).replace(/[^0-9,]/g, '').replace(',', '.'))) }}"
            },
            {
              "id": "opcoes_texto",
              "name": "opcoes_texto",
              "type": "string",
              "value": "={{ $('Agrupar Investimentos').first().json.investimentos.filter(i => i.perfil === $json.perfil && Number(i.minimo) <= Number(String($json.saldo).replace(/[^0-9,]/g, '').replace(',', '.'))).map(i => i.produto + ' (mínimo R$ ' + i.minimo + ', rentabilidade ' + i.rentabilidade + ')').join('; ') || 'nenhuma opção disponível para o saldo atual' }}"
            },
            {
              "id": "mensagem_estatica",
              "name": "mensagem_estatica",
              "type": "string",
              "value": "={{ 'Olá, ' + $json.nome.split(' ')[0] + '! ' + ({ Conservador: 'Como seu perfil é Conservador, nosso foco é renda fixa e segurança para o seu patrimônio.', Moderado: 'Como seu perfil é Moderado, sugerimos um mix equilibrado entre renda fixa e renda variável.', Arrojado: 'Como seu perfil é Arrojado, destacamos ações e opções com maior potencial de retorno.' }[$json.perfil] || 'Temos opções de investimento para você.') + ' Recomendações para você: ' + ($('Agrupar Investimentos').first().json.investimentos.filter(i => i.perfil === $json.perfil && Number(i.minimo) <= Number(String($json.saldo).replace(/[^0-9,]/g, '').replace(',', '.'))).map(i => i.produto + ' (' + i.rentabilidade + ')').join(', ') || 'fale com seu assessor para montar uma estratégia') + '.' }}"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "b598089d-93b8-4f1a-bde9-6898727019d3",
      "name": "Cruzar Perfil x Investimentos",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        1248,
        128
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Cliente: {{ $json.nome }}\nPerfil de investidor: {{ $json.perfil }}\nSaldo disponível: {{ $json.saldo }}\nOpções de investimento compatíveis (perfil e valor mínimo): {{ $json.opcoes_texto }}\n\nEscreva a mensagem de recomendação para este cliente.",
        "options": {
          "systemMessage": "Você é um assistente de investimentos de uma corretora brasileira. Escreva mensagens curtas (até 5 frases), em português do Brasil, cordiais e personalizadas para cada cliente. Use o primeiro nome do cliente, considere o perfil (Conservador = segurança e renda fixa; Moderado = equilíbrio entre renda fixa e variável; Arrojado = ações e maior potencial de retorno) e o saldo disponível. Recomende somente produtos da lista de opções compatíveis fornecida e nunca invente produtos ou rentabilidades. Se não houver opção compatível, sugira começar aos poucos e falar com um assessor. Não prometa retornos garantidos. Responda apenas com o texto da mensagem.",
          "enableStreaming": false
        }
      },
      "id": "621e8555-77b9-4077-a9e1-9f5c5bd444b5",
